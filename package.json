{
  "name": "@demo-chatbot/root",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Monorepo for the demo chatbot agent project",
  "author": "Tatsuya Maki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t28hub/demo-chatbot.git"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@types/node": "catalog:",
    "lefthook": "2.1.8",
    "turbo": "2.9.14",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.0.8",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.0.8"
}
